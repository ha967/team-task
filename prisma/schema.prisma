// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// 一个标准的 schema.prisma 主要包含三个部分：

// 1. datasource：告诉 Prisma 你要连哪个数据库（PostgreSQL、MySQL、SQLite 等），以及连接地址（通常放在 .env 里用 env("DATABASE_URL") 引用，避免泄露密码）。

// 2. generator：告诉 Prisma 要生成什么客户端代码（通常就是 prisma-client-js 或新版的 prisma-client）。

// 3. 数据模型（model）：用来定义具体的表（模型）、字段和表之间的关系

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 一个用户在团队中担任的角色
enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  // username / email 的唯一性由迁移里的「部分唯一索引」保证，只对 deleted_at IS NULL 的行生效：
  //   users_username_active_key ON users (username) WHERE deleted_at IS NULL
  //   users_email_active_key    ON users (email)    WHERE deleted_at IS NULL
  // Prisma schema DSL 表达不了带 WHERE 的索引，所以这里不能写 @unique ——
  // 一旦写回来，下一次 migrate dev 就会重建全量唯一索引，把软删用户占着邮箱的 bug 带回来。
  // 另外索引是大小写敏感的：email 必须由写入方统一转小写（UserService 的 normalizeEmail），
  // 否则 Alice@x.com 与 alice@x.com 会成为两个都算「活跃」的账号。
  username     String    @db.VarChar(32)
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  // 反向关系字段（下面这些不是数据库列，而是 Prisma 用来导航关系的“虚拟字段”）
  memberships   TeamMember[]
  createdTeams  Team[]         @relation("TeamCreator")
  createdTasks  Task[]         @relation("TaskCreator")
  assignedTasks Task[]         @relation("TaskAssignee")
  comments      Comment[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Team {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(64)
  description String?
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdBy User         @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members   TeamMember[]
  tasks     Task[]

  @@index([createdById])
  @@map("teams")
}

model TeamMember {
  id       String    @id @default(uuid()) @db.Uuid
  teamId   String    @map("team_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     TeamRole  @default(MEMBER)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  // null = 仍在团队中；有值 = 该时刻离开。这不是软删：行仍然有效，是「他在这个团队待过」的历史记录。
  // 「同一时刻只能有一条活跃关系」由迁移里的部分唯一索引保证：
  //   team_members_active_key ON team_members (team_id, user_id) WHERE left_at IS NULL
  // Prisma schema DSL 表达不了带 WHERE 的索引，所以这里不能写 @@id([teamId, userId]) /
  // @@unique([teamId, userId]) —— 否则退出后重新加入会撞唯一约束，历史行也存不下。
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 「我加入的团队」要按 user_id + 活跃过滤，普通索引补上 left_at 才用得上
  @@index([userId, leftAt])
  @@map("team_members")
}

model Task {
  id            String     @id @default(uuid()) @db.Uuid
  teamId        String     @map("team_id") @db.Uuid
  title         String     @db.VarChar(200)
  description   String?
  estimateHours Int?       @map("estimate_hours") @db.SmallInt
  status        TaskStatus @default(TODO)
  priority      Int        @default(2) @db.SmallInt
  assigneeId    String?    @map("assignee_id") @db.Uuid
  createdById   String     @map("created_by") @db.Uuid
  dueAt         DateTime?  @map("due_at") @db.Timestamptz(3)
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments  Comment[]

  @@index([teamId, status, createdAt])
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // 评论是团队的历史资产：删用户不许连带删评论。项目整体走软删，硬删用户本就不该发生，
  // 所以用 Restrict 直接挡住（与 teams.created_by / tasks.created_by 一致），
  // 而不是 SetNull + authorId 可空（那会让之后所有评论查询都要处理「作者已注销」）。
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("comments")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // 只存 SHA-256 哈希，数据库泄露时拿不到可用的令牌
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
